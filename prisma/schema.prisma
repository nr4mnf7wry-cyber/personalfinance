// Schéma Prisma — Prisma Postgres (via l'intégration Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())

  entries       MonthEntry[]
  transactions  Transaction[]
  categories    Category[]
  balances      MonthBalance[]
  privateInvestments PrivateInvestment[]
  debts         Debt[]
}

// Catégories entièrement personnalisables par utilisateur : chaque nouvel
// utilisateur part de zéro (aucune catégorie créée par défaut). Elles sont
// ajoutées/renommées/supprimées librement, ou créées automatiquement lors
// d'un import Excel.
model Category {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  group      String    // "revenus" | "fixes" | "variables" | "epargne"
  name       String
  order      Int       @default(0)

  // Frais fixe actif seulement jusqu'à cette date (ex: fin d'un crédit) — au-delà,
  // la catégorie n'apparaît plus dans le formulaire de saisie mensuelle.
  expiresAt  DateTime?

  // Montant suggéré quand aucun mois précédent n'a encore de valeur pour cette
  // catégorie (au lieu de partir de 0) — utilisé notamment par les dettes, dont la
  // mensualité connue doit apparaître pré-remplie dès la première saisie.
  defaultAmount Float?

  // Catégorie spéciale "Investissement" : son montant génère/complète une Transaction
  isInvestment Boolean @default(false)
  // Catégorie spéciale "ajustement" : son montant est calculé automatiquement
  // (solde début + revenus - dépenses - solde fin), plutôt que saisi manuellement
  isAdjustment Boolean @default(false)

  createdAt  DateTime  @default(now())

  @@unique([userId, group, name])
  @@index([userId, group])
}

// Solde du compte en banque en début et fin de mois — sert à calculer
// automatiquement la catégorie d'ajustement (dépenses non trackées)
model MonthBalance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  year         Int
  month        Int

  startBalance Float?
  endBalance   Float?

  @@unique([userId, year, month])
}

// Une ligne = un poste (catégorie/sous-catégorie) pour un mois donné
model MonthEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  year         Int
  month        Int      // 1-12

  group        String   // "revenus" | "fixes" | "variables" | "epargne"
  category     String   // ex: "Salaire", "Loyer", "Investissement", ...
  subCategory  String   @default("") // "" = pas de sous-catégorie (vue condensée)
  amount       Float

  // si la ligne "Investissement" génère une transaction liée
  transactionId String?  @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year, month, category, subCategory])
  @@index([userId, year, month])
}

model Transaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  ticker      String
  label       String?    // nom complet du titre
  type        String     @default("achat") // "achat" | "vente"
  quantity    Float
  unitPrice   Float      // prix unitaire, dans la devise ci-dessous
  currency    String     @default("EUR") // devise du prix unitaire (EUR, USD, GBP...)
  amount      Float      // quantity * unitPrice, dans la devise ci-dessus
  sector      String?

  monthEntry  MonthEntry?

  createdAt   DateTime   @default(now())

  @@index([userId, ticker])
}

// Investissement non coté (immobilier, prêt privé, parts d'entreprise, crypto non
// trackée...) : pas de cours en direct, donc valorisation manuelle périodique.
model PrivateInvestment {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name              String    // ex: "Prêt à Marc", "Parts SCI Dupont", "Local commercial"
  amountInvested    Float     // capital initialement engagé
  currency          String    @default("EUR")
  startDate         DateTime
  expectedReturnPct Float?    // rendement annuel attendu, en % (optionnel)
  notes             String?

  valuations        PrivateInvestmentValuation[]
  createdAt         DateTime  @default(now())

  @@index([userId])
}

// Historique des réévaluations manuelles ("combien je pense pouvoir en retirer aujourd'hui")
model PrivateInvestmentValuation {
  id           String            @id @default(cuid())
  investmentId String
  investment   PrivateInvestment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  date            DateTime @default(now())
  estimatedValue  Float    // valeur estimée à cette date
  note            String?

  @@index([investmentId])
}

// Dette (crédit voiture, prêt hypothécaire, prêt personnel, investissement immobilier
// financé...). Le paiement mensuel est répliqué automatiquement comme catégorie de
// dépense fixe, active seulement jusqu'à la fin théorique du remboursement.
model Debt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name            String   // ex: "Crédit auto Clio", "Prêt hypothécaire maison"
  type            String   // "car" | "house" | "personal" | "real_estate_investment" | "other"
  startDate       DateTime
  amount          Float    // capital emprunté
  interestRatePct Float    // taux d'intérêt annuel, en %
  durationMonths  Int      // durée totale du remboursement, en mois
  monthlyPayment  Float    // mensualité

  // Catégorie "fixes" créée automatiquement pour tracer la mensualité dans /input,
  // active jusqu'à la fin théorique du remboursement (via son expiresAt)
  linkedCategoryId String? @unique

  notes           String?
  createdAt       DateTime @default(now())

  prepayments     DebtPrepayment[]

  @@index([userId])
}

// Remboursement anticipé (partiel ou total) : réduit le solde restant dû sans
// modifier l'échéancier théorique d'origine.
model DebtPrepayment {
  id      String @id @default(cuid())
  debtId  String
  debt    Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  date    DateTime @default(now())
  amount  Float
  note    String?

  @@index([debtId])
}
