// Schéma Prisma — Prisma Postgres (via l'intégration Vercel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())

  entries       MonthEntry[]
  transactions  Transaction[]
  categories    Category[]
  balances      MonthBalance[]
}

// Catégories entièrement personnalisables par utilisateur : chaque nouvel
// utilisateur part de zéro (aucune catégorie créée par défaut). Elles sont
// ajoutées/renommées/supprimées librement, ou créées automatiquement lors
// d'un import Excel.
model Category {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  group      String    // "revenus" | "fixes" | "variables" | "epargne"
  name       String
  order      Int       @default(0)

  // Frais fixe actif seulement jusqu'à cette date (ex: fin d'un crédit) — au-delà,
  // la catégorie n'apparaît plus dans le formulaire de saisie mensuelle.
  expiresAt  DateTime?

  // Catégorie spéciale "Investissement" : son montant génère/complète une Transaction
  isInvestment Boolean @default(false)
  // Catégorie spéciale "ajustement" : son montant est calculé automatiquement
  // (solde début + revenus - dépenses - solde fin), plutôt que saisi manuellement
  isAdjustment Boolean @default(false)

  createdAt  DateTime  @default(now())

  @@unique([userId, group, name])
  @@index([userId, group])
}

// Solde du compte en banque en début et fin de mois — sert à calculer
// automatiquement la catégorie d'ajustement (dépenses non trackées)
model MonthBalance {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  year         Int
  month        Int

  startBalance Float?
  endBalance   Float?

  @@unique([userId, year, month])
}

// Une ligne = un poste (catégorie/sous-catégorie) pour un mois donné
model MonthEntry {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  year         Int
  month        Int      // 1-12

  group        String   // "revenus" | "fixes" | "variables" | "epargne"
  category     String   // ex: "Salaire", "Loyer", "Investissement", ...
  subCategory  String   @default("") // "" = pas de sous-catégorie (vue condensée)
  amount       Float

  // si la ligne "Investissement" génère une transaction liée
  transactionId String?  @unique
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year, month, category, subCategory])
  @@index([userId, year, month])
}

model Transaction {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime
  ticker      String
  label       String?    // nom complet du titre
  type        String     @default("achat") // "achat" | "vente"
  quantity    Float
  unitPrice   Float      // prix unitaire, dans la devise ci-dessous
  currency    String     @default("EUR") // devise du prix unitaire (EUR, USD, GBP...)
  amount      Float      // quantity * unitPrice, dans la devise ci-dessus
  sector      String?

  monthEntry  MonthEntry?

  createdAt   DateTime   @default(now())

  @@index([userId, ticker])
}
